# ─────────────────────────────────────────────────────────────────────────────
# RAG portfolio — environment template
# Copy to .env and fill in. .env is gitignored; this file is not.
#   cp .env.example .env
# ─────────────────────────────────────────────────────────────────────────────

# ── Embeddings: Voyage AI ────────────────────────────────────────────────────
# Key from https://dashboard.voyageai.com/organization/api-keys  (starts "pa-")
VOYAGE_API_KEY=pa-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Locked by the brief. 1024 dims by default; must match the vector(N) column.
VOYAGE_MODEL=voyage-3.5
EMBEDDING_DIM=1024
# Voyage input_type: "document" at ingest, "query" at search. Handled in code.
# MEASURED 2026-09-19: Japanese runs ~1.20 chars/token on this corpus.
# Batch size must respect TPM, not just item count.
#   No payment method on file -> 3 RPM / 10K TPM  -> use 6  (~3k tokens/request)
#   Payment method added       -> 2000 RPM / 8M TPM -> use 64
VOYAGE_BATCH_SIZE=6
# Client-side throttle for the unpaid ceiling. Set to 0 to disable once billing
# is configured. Ingestion retries on HTTP 429 with exponential backoff.
VOYAGE_MIN_REQUEST_INTERVAL_SEC=21
VOYAGE_MAX_RETRIES=6

# ── Generation: Claude API ───────────────────────────────────────────────────
# Key from https://console.anthropic.com/settings/keys  (starts "sk-ant-")
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
ANTHROPIC_MODEL=claude-sonnet-5
GENERATION_MAX_TOKENS=2048
# Sonnet 5 thinks adaptively by default; thinking bills as output. low|medium|high|xhigh|max
GENERATION_EFFORT=low
# Hard project budget. rag/agent.py refuses a run that could cross it (data/spend_ledger.jsonl).
BUDGET_USD=5.00

# ── Vector store: Neon (Postgres + pgvector) ─────────────────────────────────
# Pooled connection string from the Neon console → Connection Details.
# Keep ?sslmode=require. Password is in this URL — never commit it.
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require
# Direct (non-pooled) URL — used for DDL / migrations if pooling gets in the way.
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require

# ── Reranking (cross-encoder, runs locally via sentence-transformers) ────────
# Multilingual reranker - the corpus is 100% Japanese (switched 2026-09-21).
# Alternatives:
#   RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2  (brief default, English-trained)
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
#   RERANKER_MODEL=jinaai/jina-reranker-v2-base-multilingual
# Where HuggingFace caches model weights (first run downloads ~90MB-2GB).
HF_HOME=./.cache/huggingface

# ── Retrieval parameters ─────────────────────────────────────────────────────
RETRIEVAL_TOP_K=20          # candidates pulled from pgvector before reranking
RERANK_TOP_N=5              # chunks handed to the generator after reranking
LEXICAL_TOP_K=10          # BM25 (char-bigram) candidates unioned with the vector top-K
# HARD DECLINE GATE — below this rerank score, skip generation entirely and
# return 「この情報からは判断できません」. Unconditional; not the agent's choice.
# Layer 1 of 2. Scores are sigmoid(bge), 0-1. Measured 2026-09-21: off-topic <= 0.001,
# retrieval miss 0.09, on-topic questions 0.55+. Catches only those two; layer 2 (quote
# verification in rag/agent.py) handles on-topic unanswerable. Recheck in step 5.
RERANK_SCORE_THRESHOLD=0.3
# retrieve_full_document cap, in Claude tokens. Full documents run 11k-62k;
# uncapped, one call on the 通常枠 公募要領 is ~$0.12 input at Sonnet rates.
FULLDOC_MAX_TOKENS=20000
# Claude/Voyage token ratio: measured 1.215-1.364 via count_tokens; 1.40 = worst + margin.
CLAUDE_PER_VOYAGE_TOKEN=1.40

# ── Chunking: Docling HybridChunker ──────────────────────────────────────────
CHUNK_MAX_TOKENS=512
CHUNK_MERGE_PEERS=true

# ── FastAPI serving ──────────────────────────────────────────────────────────
API_HOST=127.0.0.1
API_PORT=8000
LOG_LEVEL=INFO
